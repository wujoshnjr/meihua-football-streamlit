        "step_order": [
          "辨陰陽遁",
          "定節氣",
          "定三元符頭",
          "依陰陽順逆布六儀三奇成地盤",
          "符頭加用時干",
          "定值符",
          "布星",
          "由符頭宮數至用時定值使",
          "成天盤"
        ],
        "examples": [
          {
            "label": "芒種後癸亥日丙辰時",
            "dun": "陽遁",
            "yuan": "下元",
            "ju": 9,
            "hour_xun_head": "甲寅",
            "chief_star_source_statement": "中宮天禽移至兌宮",
            "chief_door_source_statement": "借坤宮死門加兌宮"
          },
          {
