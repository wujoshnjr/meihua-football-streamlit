    {
      "number": 18,
      "name": "蠱",
      "symbol": "䷑",
      "upper": "艮",
      "lower": "巽",
      "source_name": "蠱",
      "guaci": {
        "classical_text": "元亨。利涉大川，先甲三日，後甲三日。",
        "source_page_start": "KR1a0001_tls_018-2a"
      },
      "tuan": {
        "classical_text": "《蠱》、剛上而柔下，巽而止，《蠱》。《蠱》「元亨」，而天下治也。「利涉大川」、往有事也。「先甲三日、後甲三日」，終則有始，天行也。",
        "source_page_start": "KR1a0001_tls_018-3a"
      },
      "xiang": {
        "classical_text": "山下有風，《蠱》。君子以振民育德。",
        "source_page_start": "KR1a0001_tls_018-4a",
        "note": null
      },
      "lines": [
        {
          "marker": "初六",
          "classical_text": "幹父之蠱，有子，考无咎，厲終吉。",
          "source_page_start": "KR1a0001_tls_018-5a",
          "xiaoxiang": {
            "classical_text": "「幹父之蠱」、意承「考」也。",
            "source_page_start": "KR1a0001_tls_018-6a",
            "status": "MAPPED"
          },
          "line": 1
        },
        {
          "marker": "九二",
          "classical_text": "幹母之蠱，不可貞。",
          "source_page_start": "KR1a0001_tls_018-7a",
          "xiaoxiang": {
            "classical_text": "「幹母之蠱」、得中道也。",
            "source_page_start": "KR1a0001_tls_018-8a",
            "status": "MAPPED"
          },
          "line": 2
        },
        {
          "marker": "九三",
          "classical_text": "幹父之蠱，小有悔，无大咎。",
          "source_page_start": "KR1a0001_tls_018-9a",
          "xiaoxiang": {
            "classical_text": "「幹父之蠱」、終「无咎」也。",
            "source_page_start": "KR1a0001_tls_018-10a",
            "status": "MAPPED"
          },
          "line": 3
        },
        {
          "marker": "六四",
          "classical_text": "裕父之蠱，往見吝。",
          "source_page_start": "KR1a0001_tls_018-11a",
          "xiaoxiang": {
            "classical_text": "「裕父之蠱」、往未得也。",
            "source_page_start": "KR1a0001_tls_018-12a",
            "status": "MAPPED"
          },
          "line": 4
        },
        {
          "marker": "六五",
          "classical_text": "幹父之蠱，用譽。",
          "source_page_start": "KR1a0001_tls_018-13a",
          "xiaoxiang": {
            "classical_text": "「幹父用譽」、承以德也。",
            "source_page_start": "KR1a0001_tls_018-14a",
            "status": "MAPPED"
          },
          "line": 5
        },
        {
          "marker": "上九",
          "classical_text": "不事王侯，高尚其事。",
          "source_page_start": "KR1a0001_tls_018-15a",
          "xiaoxiang": {
            "classical_text": "「不事王侯」、志可則也。",
            "source_page_start": "KR1a0001_tls_018-16a",
            "status": "MAPPED"
          },
          "line": 6
        }
      ],
      "use_line": null,
