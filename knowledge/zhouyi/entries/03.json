      "source_name": "賁",
      "guaci": {
        "classical_text": "亨。小利有攸往。",
        "source_page_start": "KR1a0001_tls_022-2a"
      },
      "tuan": {
        "classical_text": "《賁》「亨」，柔來而文剛，故「亨」。分剛上而文柔，故「小利有攸往」。剛柔交錯、天文也。文明以止，人文也。觀乎天文以察時變，觀乎人文以化成天下。",
        "source_page_start": "KR1a0001_tls_022-3a"
      },
      "xiang": {
        "classical_text": "山下有火，《賁》。君子以明庶政，无敢折獄。",
        "source_page_start": "KR1a0001_tls_022-4a",
        "note": null
      },
      "lines": [
        {
          "marker": "初九",
          "classical_text": "賁其趾，舍車而徒。",
          "source_page_start": "KR1a0001_tls_022-5a",
          "xiaoxiang": {
            "classical_text": "「舍車而徒」、義弗乘也。",
            "source_page_start": "KR1a0001_tls_022-6a",
            "status": "MAPPED"
          },
          "line": 1
        },
        {
          "marker": "六二",
          "classical_text": "賁其須。",
          "source_page_start": "KR1a0001_tls_022-7a",
          "xiaoxiang": {
            "classical_text": "「賁其須」、與上興也。",
            "source_page_start": "KR1a0001_tls_022-8a",
            "status": "MAPPED"
          },
          "line": 2
        },
        {
          "marker": "九三",
          "classical_text": "賁如濡如，永貞吉。",
          "source_page_start": "KR1a0001_tls_022-9a",
          "xiaoxiang": {
            "classical_text": "「永貞」之「吉」、終莫之陵也。",
            "source_page_start": "KR1a0001_tls_022-10a",
            "status": "MAPPED"
          },
          "line": 3
        },
        {
          "marker": "六四",
          "classical_text": "賁如皤如，白馬翰如，匪寇，婚媾。",
          "source_page_start": "KR1a0001_tls_022-11a",
          "xiaoxiang": {
            "classical_text": "「六四」、當位疑也，「匪寇婚媾」、終无尤也。",
            "source_page_start": "KR1a0001_tls_022-12a",
            "status": "MAPPED"
          },
          "line": 4
        },
        {
          "marker": "六五",
          "classical_text": "賁于丘園，束帛戔戔，吝終吉。",
          "source_page_start": "KR1a0001_tls_022-13a",
          "xiaoxiang": {
            "classical_text": "「六五」之「吉」、有喜也。",
            "source_page_start": "KR1a0001_tls_022-14a",
            "status": "MAPPED"
          },
          "line": 5
        },
        {
          "marker": "上九",
          "classical_text": "白賁，无咎。",
          "source_page_start": "KR1a0001_tls_022-15a",
          "xiaoxiang": {
            "classical_text": "「白賁无咎」、上得志也。",
