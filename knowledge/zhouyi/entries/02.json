    {
      "number": 10,
      "name": "履",
      "symbol": "䷉",
      "upper": "乾",
      "lower": "兌",
      "source_name": "履",
      "guaci": {
        "classical_text": "履虎尾，不咥人。亨。",
        "source_page_start": "KR1a0001_tls_010-2a"
      },
      "tuan": {
        "classical_text": "《履》、柔履剛也。說而應乎乾，是以「履虎尾、不咥人、亨」，剛中正、履帝位而不疚，光明也。",
        "source_page_start": "KR1a0001_tls_010-3a"
      },
      "xiang": {
        "classical_text": "上天下澤，《履》。君子以辯上下，定民志。",
        "source_page_start": "KR1a0001_tls_010-4a",
        "note": null
      },
      "lines": [
        {
          "marker": "初九",
          "classical_text": "素履往，无咎。",
          "source_page_start": "KR1a0001_tls_010-5a",
          "xiaoxiang": {
            "classical_text": "「素履」之「往」、獨行願也。",
            "source_page_start": "KR1a0001_tls_010-6a",
            "status": "MAPPED"
          },
          "line": 1
        },
        {
          "marker": "九二",
          "classical_text": "履道坦坦，幽人貞吉。",
          "source_page_start": "KR1a0001_tls_010-7a",
          "xiaoxiang": {
            "classical_text": "「幽人貞吉」、中不自亂也。",
            "source_page_start": "KR1a0001_tls_010-8a",
            "status": "MAPPED"
          },
          "line": 2
        },
        {
          "marker": "六三",
          "classical_text": "眇能視，跛能履，履虎尾，咥人凶。武人為于大君。",
          "source_page_start": "KR1a0001_tls_010-9a",
          "xiaoxiang": {
            "classical_text": "「眇能視」、不足以有明也，「跛能履」、不足以與行也。「咥人」之「凶」、位不當也，「武人為于大君」、志剛也。",
            "source_page_start": "KR1a0001_tls_010-10a",
            "status": "MAPPED"
          },
          "line": 3
        },
        {
          "marker": "九四",
          "classical_text": "履虎尾愬愬，終吉。",
          "source_page_start": "KR1a0001_tls_010-11a",
          "xiaoxiang": {
            "classical_text": "「愬愬終吉」、志行也。",
            "source_page_start": "KR1a0001_tls_010-12a",
            "status": "MAPPED"
          },
          "line": 4
        },
        {
          "marker": "九五",
          "classical_text": "夬履貞厲。",
          "source_page_start": "KR1a0001_tls_010-13a",
          "xiaoxiang": {
            "classical_text": "「夬履貞厲」、位正當也。",
            "source_page_start": "KR1a0001_tls_010-14a",
            "status": "MAPPED"
          },
          "line": 5
        },
        {
          "marker": "上九",
          "classical_text": "視履考祥，其旋，元吉。",
