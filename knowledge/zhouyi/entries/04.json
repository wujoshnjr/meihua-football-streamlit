    {
      "number": 27,
      "name": "頤",
      "symbol": "䷚",
      "upper": "艮",
      "lower": "震",
      "source_name": "頤",
      "guaci": {
        "classical_text": "貞吉。觀頤，自求口實。",
        "source_page_start": "KR1a0001_tls_027-2a"
      },
      "tuan": {
        "classical_text": "《頤》「貞吉」，養正則吉也。「觀頤」、觀其所養也，「自求口實」、觀其自養也。天地養萬物，聖人養賢以及萬民，《頤》之時大矣哉！",
        "source_page_start": "KR1a0001_tls_027-3a"
      },
      "xiang": {
        "classical_text": "山下有雷，《頤》。君子以慎言語、節飲食。",
        "source_page_start": "KR1a0001_tls_027-4a",
        "note": null
      },
      "lines": [
        {
          "marker": "初九",
          "classical_text": "舍爾靈龜，觀我朵頤，凶。",
          "source_page_start": "KR1a0001_tls_027-5a",
          "xiaoxiang": {
            "classical_text": "「觀我朵頤」、亦不足貴也。",
