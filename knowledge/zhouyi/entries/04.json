          },
          "line": 2
        },
        {
          "marker": "六三",
          "classical_text": "无妄之災，或繫之牛，行人之得，邑人之災。",
          "source_page_start": "KR1a0001_tls_025-9a",
          "xiaoxiang": {
            "classical_text": "「行人得」牛、「邑人災」也。",
