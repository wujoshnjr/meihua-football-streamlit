          "xiaoxiang": {
            "classical_text": "「履錯」之「敬」、以辟咎也。",
            "source_page_start": "KR1a0001_tls_030-6a",
            "status": "MAPPED"
          },
          "line": 1
        },
        {
          "marker": "六二",
          "classical_text": "黃離，元吉。",
          "source_page_start": "KR1a0001_tls_030-7a",
          "xiaoxiang": {
            "classical_text": "「黃離元吉」、得中道也。",
            "source_page_start": "KR1a0001_tls_030-8a",
            "status": "MAPPED"
          },
          "line": 2
        },
        {
          "marker": "九三",
          "classical_text": "日昃之離，不鼓缶而歌，則大耋之嗟，凶。",
          "source_page_start": "KR1a0001_tls_030-9a",
          "xiaoxiang": {
            "classical_text": "「日昃之離」、何可久也？",
            "source_page_start": "KR1a0001_tls_030-10a",
            "status": "MAPPED"
          },
          "line": 3
        },
        {
          "marker": "九四",
          "classical_text": "突如、其來如，焚如，死如，棄如。",
          "source_page_start": "KR1a0001_tls_030-11a",
          "xiaoxiang": {
            "classical_text": "「突如其來如」、无所容也。",
            "source_page_start": "KR1a0001_tls_030-12a",
            "status": "MAPPED"
          },
          "line": 4
        },
        {
          "marker": "六五",
          "classical_text": "出涕沱若，戚嗟若，吉。",
          "source_page_start": "KR1a0001_tls_030-13a",
          "xiaoxiang": {
            "classical_text": "「六五」之「吉」、離王公也。",
            "source_page_start": "KR1a0001_tls_030-14a",
            "status": "MAPPED"
          },
          "line": 5
        },
        {
          "marker": "上九",
          "classical_text": "王用出征，有嘉折首，獲匪其醜，无咎。",
