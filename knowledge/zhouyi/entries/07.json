    {
      "number": 50,
      "name": "鼎",
      "symbol": "䷱",
      "upper": "離",
      "lower": "巽",
      "source_name": "鼎",
      "guaci": {
        "classical_text": "元吉，亨。",
        "source_page_start": "KR1a0001_tls_050-2a"
      },
      "tuan": {
        "classical_text": "《鼎》象也、以木巽火，亨飪也。聖人亨以享上帝，而大亨以養聖賢。巽而耳目聰明，柔進而上行，得中而應乎剛，是以「元亨」。",
        "source_page_start": "KR1a0001_tls_050-3a"
      },
      "xiang": {
        "classical_text": "木上有火，《鼎》。君子以正位凝命。",
        "source_page_start": "KR1a0001_tls_050-4a",
        "note": null
      },
      "lines": [
        {
          "marker": "初六",
          "classical_text": "鼎顛趾，利出否。得妾以其子，无咎。",
          "source_page_start": "KR1a0001_tls_050-5a",
          "xiaoxiang": {
            "classical_text": "「鼎顛趾」、未悖也，「利出否」、以從貴也。",
            "source_page_start": "KR1a0001_tls_050-6a",
            "status": "MAPPED"
          },
          "line": 1
        },
        {
          "marker": "九二",
          "classical_text": "鼎有實，我仇有疾，不我能即，吉。",
          "source_page_start": "KR1a0001_tls_050-7a",
          "xiaoxiang": {
            "classical_text": "「鼎有實」、慎所之也，「我仇有疾」、終无尤也。",
            "source_page_start": "KR1a0001_tls_050-8a",
            "status": "MAPPED"
          },
          "line": 2
        },
        {
          "marker": "九三",
          "classical_text": "鼎耳革，其行塞，雉膏不食，方雨，虧悔，終吉。",
          "source_page_start": "KR1a0001_tls_050-9a",
          "xiaoxiang": {
            "classical_text": "「鼎耳革」、失其義也。",
            "source_page_start": "KR1a0001_tls_050-10a",
            "status": "MAPPED"
          },
          "line": 3
        },
        {
          "marker": "九四",
          "classical_text": "鼎折足，覆公餗，其形渥，凶。",
          "source_page_start": "KR1a0001_tls_050-11a",
          "xiaoxiang": {
            "classical_text": "「覆公餗」、信如何也。",
            "source_page_start": "KR1a0001_tls_050-12a",
            "status": "MAPPED"
          },
          "line": 4
        },
        {
          "marker": "六五",
          "classical_text": "鼎黃耳金鉉，利貞。",
          "source_page_start": "KR1a0001_tls_050-13a",
          "xiaoxiang": {
            "classical_text": "「鼎黃耳」、中以為實也。",
            "source_page_start": "KR1a0001_tls_050-14a",
            "status": "MAPPED"
          },
          "line": 5
        },
        {
          "marker": "上九",
          "classical_text": "鼎玉鉉，大吉，无不利。",
          "source_page_start": "KR1a0001_tls_050-15a",
          "xiaoxiang": {
            "classical_text": "「玉鉉」在「上」、剛柔節也。",
            "source_page_start": "KR1a0001_tls_050-16a",
            "status": "MAPPED"
          },
          "line": 6
        }
      ],
