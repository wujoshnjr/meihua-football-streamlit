    {
      "number": 54,
      "name": "歸妹",
      "symbol": "䷵",
      "upper": "震",
      "lower": "兌",
      "source_name": "歸妹",
      "guaci": {
        "classical_text": "征凶，无攸利。",
        "source_page_start": "KR1a0001_tls_054-2a"
      },
      "tuan": {
        "classical_text": "《歸妹》、天地之大義也。天地不交而萬物不興。《歸妹》、人之終始也。說以動，所歸妹也。「征凶」、位不當也，「无攸利」、柔乘剛也。",
        "source_page_start": "KR1a0001_tls_054-3a"
      },
      "xiang": {
        "classical_text": "澤上有雷，《歸妹》。君子以永終知敝。",
        "source_page_start": "KR1a0001_tls_054-4a",
        "note": null
      },
      "lines": [
        {
          "marker": "初九",
          "classical_text": "歸妹以娣。跛能履，征吉。",
          "source_page_start": "KR1a0001_tls_054-5a",
          "xiaoxiang": {
            "classical_text": "「歸妹以娣」、以恆也，「跛能履」、「吉」相承也。",
            "source_page_start": "KR1a0001_tls_054-6a",
            "status": "MAPPED"
          },
          "line": 1
        },
        {
          "marker": "九二",
          "classical_text": "眇能視，利幽人之貞。",
          "source_page_start": "KR1a0001_tls_054-7a",
          "xiaoxiang": {
            "classical_text": "「利幽人之貞」、未變常也。",
            "source_page_start": "KR1a0001_tls_054-8a",
            "status": "MAPPED"
          },
          "line": 2
        },
        {
          "marker": "六三",
          "classical_text": "歸妹以須，反歸以娣。",
          "source_page_start": "KR1a0001_tls_054-9a",
          "xiaoxiang": {
            "classical_text": "「歸妹以須」、未當也。",
            "source_page_start": "KR1a0001_tls_054-10a",
            "status": "MAPPED"
          },
          "line": 3
        },
        {
          "marker": "九四",
          "classical_text": "歸妹愆期，遲歸有時。",
          "source_page_start": "KR1a0001_tls_054-11a",
          "xiaoxiang": {
            "classical_text": "「愆期」之志、有待而行也。",
            "source_page_start": "KR1a0001_tls_054-12a",
            "status": "MAPPED"
          },
          "line": 4
        },
        {
          "marker": "六五",
          "classical_text": "帝乙歸妹，其君之袂不如其娣之袂良。月幾望、吉。",
          "source_page_start": "KR1a0001_tls_054-13a",
          "xiaoxiang": {
            "classical_text": "「帝乙歸妹」、「不如其娣之袂良」也。其位在中，以貴行也。",
            "source_page_start": "KR1a0001_tls_054-14a",
            "status": "MAPPED"
          },
          "line": 5
        },
        {
          "marker": "上六",
          "classical_text": "女承筐，无實，士刲羊，无血，无攸利。",
          "source_page_start": "KR1a0001_tls_054-15a",
          "xiaoxiang": {
            "classical_text": "「上六」「无實」、「承」虛「筐」也。",
            "source_page_start": "KR1a0001_tls_054-16a",
            "status": "MAPPED"
          },
          "line": 6
        }
