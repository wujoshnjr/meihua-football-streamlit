    {
      "number": 55,
      "name": "豐",
      "symbol": "䷶",
      "upper": "震",
      "lower": "離",
      "source_name": "豐",
      "guaci": {
        "classical_text": "亨，王假之。勿憂，宜日中。",
        "source_page_start": "KR1a0001_tls_055-2a"
      },
      "tuan": {
        "classical_text": "《豐》、大也。明以動，故《豐》。「王假之」、尚大也。「勿憂宜日中」、宜照天下也。日中則昃，月盈則食，天地盈虛，與時消息，而況於人乎，況於鬼神乎？",
        "source_page_start": "KR1a0001_tls_055-3a"
      },
      "xiang": {
        "classical_text": "雷電皆至，《豐》。君子以折獄致刑。",
        "source_page_start": "KR1a0001_tls_055-4a",
        "note": null
      },
      "lines": [
        {
          "marker": "初九",
          "classical_text": "遇其配主，雖旬无咎，往有尚。",
          "source_page_start": "KR1a0001_tls_055-5a",
          "xiaoxiang": {
            "classical_text": "「雖旬无咎」、過旬災也。",
            "source_page_start": "KR1a0001_tls_055-6a",
            "status": "MAPPED"
          },
          "line": 1
        },
        {
          "marker": "六二",
          "classical_text": "豐其蔀，日中見斗。往得疑疾，有孚，發若吉。",
          "source_page_start": "KR1a0001_tls_055-7a",
          "xiaoxiang": {
            "classical_text": "「有孚發若」、信以發志也。",
            "source_page_start": "KR1a0001_tls_055-8a",
            "status": "MAPPED"
          },
          "line": 2
        },
        {
          "marker": "九三",
          "classical_text": "豐其沛，日中見沬，折其右肱，无咎。",
          "source_page_start": "KR1a0001_tls_055-9a",
          "xiaoxiang": {
            "classical_text": "「豐其沛」、不可大事也，「折其右肱」、終不可用也。",
            "source_page_start": "KR1a0001_tls_055-10a",
            "status": "MAPPED"
          },
          "line": 3
        },
        {
          "marker": "九四",
          "classical_text": "豐其蔀，日中見斗，遇其夷主，吉。",
          "source_page_start": "KR1a0001_tls_055-11a",
          "xiaoxiang": {
            "classical_text": "「豐其蔀」、位不當也。「日中見斗」、幽不明也，「遇其夷主」、「吉」行也。",
            "source_page_start": "KR1a0001_tls_055-12a",
            "status": "MAPPED"
          },
          "line": 4
        },
        {
          "marker": "六五",
          "classical_text": "來章，有慶譽，吉。",
          "source_page_start": "KR1a0001_tls_055-13a",
          "xiaoxiang": {
            "classical_text": "「六五」之「吉」、有慶也。",
            "source_page_start": "KR1a0001_tls_055-14a",
            "status": "MAPPED"
          },
          "line": 5
        },
        {
          "marker": "上六",
          "classical_text": "豐其屋，蔀其家，闚其戶，闃其无人，三歲不覿，凶。",
          "source_page_start": "KR1a0001_tls_055-15a",
          "xiaoxiang": {
            "classical_text": "「豐其屋」、天際翔也。「闚其戶、闃其无人」、自藏也。",
            "source_page_start": "KR1a0001_tls_055-16a",
            "status": "MAPPED"
          },
          "line": 6
        }
      ],
      "use_line": null,
      "raw_classical_transcription": "《豐》亨，王假之。勿憂，宜日中。《彖》曰：《豐》、大也。明以動，故《豐》。「王假之」、尚大也。「勿憂宜日中」、宜照天下也。日中則昃，月盈則食，天地盈虛，與時消息，而況於人乎，況於鬼神乎？《象》曰：雷電皆至，《豐》。君子以折獄致刑。初九：遇其配主，雖旬无咎，往有尚。《象》曰：「雖旬无咎」、過旬災也。六二：豐其蔀，日中見斗。往得疑疾，有孚，發若吉。《象》曰：「有孚發若」、信以發志也。九三：豐其沛，日中見沬，折其右肱，无咎。《象》曰：「豐其沛」、不可大事也，「折其右肱」、終不可用也。九四：豐其蔀，日中見斗，遇其夷主，吉。《象》曰：「豐其蔀」、位不當也。「日中見斗」、幽不明也，「遇其夷主」、「吉」行也。六五：來章，有慶譽，吉。《象》曰：「六五」之「吉」、有慶也。上六：豐其屋，蔀其家，闚其戶，闃其无人，三歲不覿，凶。《象》曰：「豐其屋」、天際翔也。「闚其戶、闃其无人」、自藏也。",
