    {
      "number": 5,
      "name": "需",
      "symbol": "䷄",
      "upper": "坎",
      "lower": "乾",
      "source_name": "需",
      "guaci": {
        "classical_text": "有孚，光亨。貞吉。利涉大川。",
        "source_page_start": "KR1a0001_tls_005-2a"
      },
      "tuan": {
        "classical_text": "《需》、須也。險在前也，剛健而不陷，其義不困窮矣。《需》、「有孚、光亨、貞吉」，位乎天位以正中也。「利涉大川」、往有功也。",
        "source_page_start": "KR1a0001_tls_005-3a"
      },
      "xiang": {
        "classical_text": "雲上於天，《需》。君子以飲食宴樂。",
        "source_page_start": "KR1a0001_tls_005-4a",
        "note": null
      },
      "lines": [
        {
          "marker": "初九",
          "classical_text": "需于郊，利用恆，无咎。",
          "source_page_start": "KR1a0001_tls_005-5a",
          "xiaoxiang": {
            "classical_text": "「需于郊」、不犯難行也。「利用恆无咎」、未失常也。",
            "source_page_start": "KR1a0001_tls_005-6a",
            "status": "MAPPED"
          },
          "line": 1
        },
        {
          "marker": "九二",
          "classical_text": "需于沙，小有言，終吉。",
          "source_page_start": "KR1a0001_tls_005-7a",
          "xiaoxiang": {
            "classical_text": "「需于沙」、行在中也。雖「小有言」、以「吉」「終」也。",
            "source_page_start": "KR1a0001_tls_005-8a",
            "status": "MAPPED"
          },
          "line": 2
        },
        {
          "marker": "九三",
          "classical_text": "需于泥，致寇至。",
          "source_page_start": "KR1a0001_tls_005-9a",
          "xiaoxiang": {
            "classical_text": "「需于泥」、災在外也。自我「致寇」、敬慎不敗也。",
            "source_page_start": "KR1a0001_tls_005-10a",
            "status": "MAPPED"
          },
          "line": 3
        },
        {
          "marker": "六四",
          "classical_text": "需于血，出自穴。",
          "source_page_start": "KR1a0001_tls_005-11a",
          "xiaoxiang": {
            "classical_text": "「需于血」、順以聽也。",
            "source_page_start": "KR1a0001_tls_005-12a",
            "status": "MAPPED"
          },
          "line": 4
        },
        {
          "marker": "九五",
          "classical_text": "需于酒食，貞吉。",
          "source_page_start": "KR1a0001_tls_005-13a",
          "xiaoxiang": {
            "classical_text": "「酒食貞吉」、以中正也。",
            "source_page_start": "KR1a0001_tls_005-14a",
            "status": "MAPPED"
          },
          "line": 5
        },
        {
          "marker": "上六",
          "classical_text": "入于穴，有不速之客三人來，敬之終吉。",
          "source_page_start": "KR1a0001_tls_005-15a",
          "xiaoxiang": {
            "classical_text": "「不速之客來、敬之終吉」也，雖不當位，未大失也。",
            "source_page_start": "KR1a0001_tls_005-16a",
            "status": "MAPPED"
          },
          "line": 6
        }
      ],
      "use_line": null,
      "raw_classical_transcription": "《需》有孚，光亨。貞吉。利涉大川。《彖》曰：《需》、須也。險在前也，剛健而不陷，其義不困窮矣。《需》、「有孚、光亨、貞吉」，位乎天位以正中也。「利涉大川」、往有功也。《象》曰：雲上於天，《需》。君子以飲食宴樂。初九：需于郊，利用恆，无咎。《象》曰：「需于郊」、不犯難行也。「利用恆无咎」、未失常也。九二：需于沙，小有言，終吉。《象》曰：「需于沙」、行在中也。雖「小有言」、以「吉」「終」也。九三：需于泥，致寇至。《象》曰：「需于泥」、災在外也。自我「致寇」、敬慎不敗也。六四：需于血，出自穴。《象》曰：「需于血」、順以聽也。九五：需于酒食，貞吉。《象》曰：「酒食貞吉」、以中正也。上六：入于穴，有不速之客三人來，敬之終吉。《象》曰：「不速之客來、敬之終吉」也，雖不當位，未大失也。",
      "source": {
        "repository": "kanripo/KR1a0001",
        "commit": "8284adbf9e3435d713180e24f05bf75f8b7d1d96",
        "edition": "Kanripo TLS digital transcription",
        "file": "KR1a0001_005.txt",
