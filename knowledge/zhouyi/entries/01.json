    {
      "number": 8,
      "name": "比",
      "symbol": "䷇",
      "upper": "坎",
      "lower": "坤",
      "source_name": "比",
      "guaci": {
        "classical_text": "吉。原筮元，永貞无咎。不寧方來，後夫凶。",
