    {
      "number": 7,
      "name": "師",
      "symbol": "䷆",
      "upper": "坤",
      "lower": "坎",
      "source_name": "師",
      "guaci": {
        "classical_text": "貞丈人吉，无咎。",
        "source_page_start": "KR1a0001_tls_007-2a"
      },
      "tuan": {
        "classical_text": "「師」、眾也，「貞」、正也。能以眾正，可以王矣。剛中而應，行險而順，以此毒天下而民從之，「吉」、又何咎矣。",
        "source_page_start": "KR1a0001_tls_007-3a"
      },
      "xiang": {
        "classical_text": "地中有水，《師》。君子以容民畜眾。",
        "source_page_start": "KR1a0001_tls_007-4a",
        "note": null
      },
      "lines": [
        {
          "marker": "初六",
          "classical_text": "師出以律，否臧凶。",
          "source_page_start": "KR1a0001_tls_007-5a",
          "xiaoxiang": {
            "classical_text": "「師出以律」，失律「凶」也。",
            "source_page_start": "KR1a0001_tls_007-6a",
            "status": "MAPPED"
          },
          "line": 1
        },
        {
          "marker": "九二",
          "classical_text": "在師中，吉、无咎，王三錫命。",
          "source_page_start": "KR1a0001_tls_007-7a",
          "xiaoxiang": {
            "classical_text": "「在師中吉」、承天寵也，「王三錫命」、懷萬邦也。",
            "source_page_start": "KR1a0001_tls_007-8a",
            "status": "MAPPED"
          },
          "line": 2
        },
        {
          "marker": "六三",
          "classical_text": "師或輿尸，凶。",
          "source_page_start": "KR1a0001_tls_007-9a",
          "xiaoxiang": {
            "classical_text": "「師或輿尸」、大无功也。",
            "source_page_start": "KR1a0001_tls_007-10a",
            "status": "MAPPED"
          },
          "line": 3
        },
        {
          "marker": "六四",
          "classical_text": "師左次，无咎。",
          "source_page_start": "KR1a0001_tls_007-11a",
          "xiaoxiang": {
            "classical_text": "「左次无咎」、未失常也。",
            "source_page_start": "KR1a0001_tls_007-12a",
            "status": "MAPPED"
          },
          "line": 4
        },
        {
          "marker": "六五",
          "classical_text": "田有禽。利執言，无咎。長子帥師，弟子輿尸，貞凶。",
          "source_page_start": "KR1a0001_tls_007-13a",
          "xiaoxiang": {
            "classical_text": "「長子帥師」、以中行也，「弟子輿尸」、使不當也。",
            "source_page_start": "KR1a0001_tls_007-14a",
            "status": "MAPPED"
          },
          "line": 5
        },
        {
          "marker": "上六",
          "classical_text": "大君有命，開國承家，小人勿用。",
          "source_page_start": "KR1a0001_tls_007-15a",
          "xiaoxiang": {
            "classical_text": "「大君有命」、以正功也，「小人勿用」、必亂邦也。",
            "source_page_start": "KR1a0001_tls_007-16a",
            "status": "MAPPED"
          },
          "line": 6
        }
      ],
      "use_line": null,
      "raw_classical_transcription": "《師》貞丈人吉，无咎。《彖》曰：「師」、眾也，「貞」、正也。能以眾正，可以王矣。剛中而應，行險而順，以此毒天下而民從之，「吉」、又何咎矣。《象》曰：地中有水，《師》。君子以容民畜眾。初六：師出以律，否臧凶。《象》曰：「師出以律」，失律「凶」也。九二：在師中，吉、无咎，王三錫命。《象》曰：「在師中吉」、承天寵也，「王三錫命」、懷萬邦也。六三：師或輿尸，凶。《象》曰：「師或輿尸」、大无功也。六四：師左次，无咎。《象》曰：「左次无咎」、未失常也。六五：田有禽。利執言，无咎。長子帥師，弟子輿尸，貞凶。《象》曰：「長子帥師」、以中行也，「弟子輿尸」、使不當也。上六：大君有命，開國承家，小人勿用。《象》曰：「大君有命」、以正功也，「小人勿用」、必亂邦也。",
