    {
      "number": 38,
      "name": "睽",
      "symbol": "䷥",
      "upper": "離",
      "lower": "兌",
      "source_name": "睽",
      "guaci": {
        "classical_text": "小事吉。",
        "source_page_start": "KR1a0001_tls_038-2a"
      },
      "tuan": {
        "classical_text": "《睽》、火動而上，澤動而下。二女同居，其志不同行。說而麗乎明，柔進而上行，得中而應乎剛，是以「小事吉」。天地睽而其事同也。男女睽而其志通也。萬物睽而其事類也，睽之時用大矣哉！",
        "source_page_start": "KR1a0001_tls_038-3a"
      },
      "xiang": {
        "classical_text": "上火下澤，《睽》。君子以同而異。",
        "source_page_start": "KR1a0001_tls_038-4a",
        "note": null
      },
      "lines": [
        {
          "marker": "初九",
          "classical_text": "悔亡。喪馬，勿逐自復。見惡人无咎。",
          "source_page_start": "KR1a0001_tls_038-5a",
          "xiaoxiang": {
            "classical_text": "「見惡人」、以辟「咎」也。",
            "source_page_start": "KR1a0001_tls_038-6a",
            "status": "MAPPED"
          },
          "line": 1
        },
        {
          "marker": "九二",
          "classical_text": "遇主于巷，无咎。",
          "source_page_start": "KR1a0001_tls_038-7a",
          "xiaoxiang": {
            "classical_text": "「遇主于巷」、未失道也。",
            "source_page_start": "KR1a0001_tls_038-8a",
            "status": "MAPPED"
          },
          "line": 2
        },
        {
          "marker": "六三",
          "classical_text": "見輿曳，其牛掣，其人天且劓，无初有終。",
          "source_page_start": "KR1a0001_tls_038-9a",
          "xiaoxiang": {
            "classical_text": "「見輿曳」、位不當也，「无初有終」、遇剛也。",
            "source_page_start": "KR1a0001_tls_038-10a",
            "status": "MAPPED"
          },
          "line": 3
        },
        {
          "marker": "九四",
          "classical_text": "睽孤，遇元夫，交孚，厲无咎。",
          "source_page_start": "KR1a0001_tls_038-11a",
          "xiaoxiang": {
            "classical_text": "「交孚无咎」、志行也。",
            "source_page_start": "KR1a0001_tls_038-12a",
            "status": "MAPPED"
          },
          "line": 4
        },
        {
          "marker": "六五",
          "classical_text": "悔亡。厥宗噬膚，往何咎？",
          "source_page_start": "KR1a0001_tls_038-13a",
          "xiaoxiang": {
            "classical_text": "「厥宗噬膚」、「往」有慶也。",
            "source_page_start": "KR1a0001_tls_038-14a",
            "status": "MAPPED"
          },
          "line": 5
        },
        {
          "marker": "上九",
          "classical_text": "睽孤，見豕負塗，載鬼一車，先張之弧，後說之弧，匪寇，婚媾。往遇雨，則吉。",
          "source_page_start": "KR1a0001_tls_038-15a",
          "xiaoxiang": {
            "classical_text": "「遇雨」之「吉」、群疑亡也。",
            "source_page_start": "KR1a0001_tls_038-16a",
            "status": "MAPPED"
          },
          "line": 6
        }
      ],
      "use_line": null,
      "raw_classical_transcription": "《睽》小事吉。《彖》曰：《睽》、火動而上，澤動而下。二女同居，其志不同行。說而麗乎明，柔進而上行，得中而應乎剛，是以「小事吉」。天地睽而其事同也。男女睽而其志通也。萬物睽而其事類也，睽之時用大矣哉！《象》曰：上火下澤，《睽》。君子以同而異。初九：悔亡。喪馬，勿逐自復。見惡人无咎。《象》曰：「見惡人」、以辟「咎」也。九二：遇主于巷，无咎。《象》曰：「遇主于巷」、未失道也。六三：見輿曳，其牛掣，其人天且劓，无初有終。《象》曰：「見輿曳」、位不當也，「无初有終」、遇剛也。九四：睽孤，遇元夫，交孚，厲无咎。《象》曰：「交孚无咎」、志行也。六五：悔亡。厥宗噬膚，往何咎？《象》曰：「厥宗噬膚」、「往」有慶也。上九：睽孤，見豕負塗，載鬼一車，先張之弧，後說之弧，匪寇，婚媾。往遇雨，則吉。《象》曰：「遇雨」之「吉」、群疑亡也。",
