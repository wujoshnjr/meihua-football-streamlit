    {
      "number": 34,
      "name": "大壯",
      "symbol": "䷡",
      "upper": "震",
      "lower": "乾",
      "source_name": "大壯",
      "guaci": {
        "classical_text": "利貞。",
        "source_page_start": "KR1a0001_tls_034-2a"
      },
      "tuan": {
        "classical_text": "《大壯》、大者壯也。剛以動，故壯。《大壯》「利貞」，大者、正也。正大而天地之情可見矣。",
        "source_page_start": "KR1a0001_tls_034-3a"
      },
      "xiang": {
        "classical_text": "雷在天上，《大壯》。君子以非禮弗履。",
        "source_page_start": "KR1a0001_tls_034-4a",
        "note": null
      },
      "lines": [
        {
          "marker": "初九",
          "classical_text": "壯于趾，征凶有孚。",
          "source_page_start": "KR1a0001_tls_034-5a",
          "xiaoxiang": {
            "classical_text": "「壯于趾」、其「孚」窮也。",
            "source_page_start": "KR1a0001_tls_034-6a",
            "status": "MAPPED"
          },
          "line": 1
        },
        {
          "marker": "九二",
          "classical_text": "貞吉。",
          "source_page_start": "KR1a0001_tls_034-7a",
          "xiaoxiang": {
            "classical_text": "「九二貞吉」、以中也。",
            "source_page_start": "KR1a0001_tls_034-8a",
            "status": "MAPPED"
          },
          "line": 2
        },
        {
          "marker": "九三",
          "classical_text": "小人用壯，君子用罔，貞厲。羝羊觸藩，羸其角。",
          "source_page_start": "KR1a0001_tls_034-9a",
          "xiaoxiang": {
            "classical_text": "「小人用壯、君子用罔」也。",
            "source_page_start": "KR1a0001_tls_034-10a",
            "status": "MAPPED"
          },
          "line": 3
        },
        {
          "marker": "九四",
          "classical_text": "貞吉，悔亡。藩決不羸，壯于大輿之輹。",
          "source_page_start": "KR1a0001_tls_034-11a",
          "xiaoxiang": {
            "classical_text": "「藩決不羸」、尚往也。",
            "source_page_start": "KR1a0001_tls_034-12a",
            "status": "MAPPED"
          },
          "line": 4
        },
        {
          "marker": "六五",
          "classical_text": "喪羊于易，无悔。",
          "source_page_start": "KR1a0001_tls_034-13a",
          "xiaoxiang": {
            "classical_text": "「喪羊于易」、位不當也。",
            "source_page_start": "KR1a0001_tls_034-14a",
            "status": "MAPPED"
          },
          "line": 5
        },
        {
          "marker": "上六",
          "classical_text": "羝羊觸藩，不能退，不能遂，无攸利，艱則吉。",
          "source_page_start": "KR1a0001_tls_034-15a",
          "xiaoxiang": {
            "classical_text": "「不能退、不能遂」、不詳也，「艱則吉」、咎不長也。",
            "source_page_start": "KR1a0001_tls_034-16a",
            "status": "MAPPED"
          },
          "line": 6
        }
      ],
      "use_line": null,
      "raw_classical_transcription": "《大壯》利貞。《彖》曰：《大壯》、大者壯也。剛以動，故壯。《大壯》「利貞」，大者、正也。正大而天地之情可見矣。《象》曰：雷在天上，《大壯》。君子以非禮弗履。初九：壯于趾，征凶有孚。《象》曰：「壯于趾」、其「孚」窮也。九二：貞吉。《象》曰：「九二貞吉」、以中也。九三：小人用壯，君子用罔，貞厲。羝羊觸藩，羸其角。《象》曰：「小人用壯、君子用罔」也。九四：貞吉，悔亡。藩決不羸，壯于大輿之輹。《象》曰：「藩決不羸」、尚往也。六五：喪羊于易，无悔。《象》曰：「喪羊于易」、位不當也。上六：羝羊觸藩，不能退，不能遂，无攸利，艱則吉。《象》曰：「不能退、不能遂」、不詳也，「艱則吉」、咎不長也。",
      "source": {
