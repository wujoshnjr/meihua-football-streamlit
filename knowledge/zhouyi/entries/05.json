          "line": 2
        },
        {
          "marker": "九三",
          "classical_text": "家人嗃嗃，悔厲，吉；婦子嘻嘻，終吝。",
          "source_page_start": "KR1a0001_tls_037-9a",
          "xiaoxiang": {
            "classical_text": "「家人嗃嗃」、未失也，「婦子嘻嘻」、失家節也。",
