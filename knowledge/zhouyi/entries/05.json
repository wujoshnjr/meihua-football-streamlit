          "line": 4
        },
        {
          "marker": "九五",
          "classical_text": "王假有家，勿恤，吉。",
          "source_page_start": "KR1a0001_tls_037-13a",
          "xiaoxiang": {
            "classical_text": "「王假有家」、交相愛也。",
            "source_page_start": "KR1a0001_tls_037-14a",
            "status": "MAPPED"
          },
          "line": 5
        },
        {
          "marker": "上九",
          "classical_text": "有孚威如，終吉。",
          "source_page_start": "KR1a0001_tls_037-15a",
          "xiaoxiang": {
            "classical_text": "「威如」之「吉」、反身之謂也。",
