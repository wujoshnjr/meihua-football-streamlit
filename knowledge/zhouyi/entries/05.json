          "xiaoxiang": {
            "classical_text": "「往蹇來反」、內喜之也。",
            "source_page_start": "KR1a0001_tls_039-10a",
            "status": "MAPPED"
          },
          "line": 3
        },
        {
          "marker": "六四",
          "classical_text": "往蹇來連。",
          "source_page_start": "KR1a0001_tls_039-11a",
          "xiaoxiang": {
            "classical_text": "「往蹇來連」、當位實也。",
