          "xiaoxiang": {
            "classical_text": "「大蹇朋來」、以中節也。",
            "source_page_start": "KR1a0001_tls_039-14a",
            "status": "MAPPED"
          },
          "line": 5
        },
        {
          "marker": "上六",
          "classical_text": "往蹇，來碩，吉，利見大人。",
          "source_page_start": "KR1a0001_tls_039-15a",
          "xiaoxiang": {
            "classical_text": "「往蹇來碩」、志在內也，「利見大人」、以從貴也。",
