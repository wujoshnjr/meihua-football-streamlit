    {
      "number": 35,
      "name": "晉",
      "symbol": "䷢",
      "upper": "離",
      "lower": "坤",
      "source_name": "晉",
      "guaci": {
        "classical_text": "康侯用錫馬蕃庶，晝日三接。",
        "source_page_start": "KR1a0001_tls_035-2a"
      },
      "tuan": {
        "classical_text": "《晉》、進也。明出地上。順而麗乎大明，柔進而上行，是以「康侯」用「錫馬蕃庶晝日三接」也。",
        "source_page_start": "KR1a0001_tls_035-3a"
      },
      "xiang": {
        "classical_text": "明出地上，《晉》。君子以自昭明德。",
        "source_page_start": "KR1a0001_tls_035-4a",
        "note": null
      },
      "lines": [
        {
          "marker": "初六",
          "classical_text": "晉如摧如，貞吉。罔孚，裕无咎。",
          "source_page_start": "KR1a0001_tls_035-5a",
          "xiaoxiang": {
            "classical_text": "「晉如摧如」、獨行正也，「裕无咎」、未受命也。",
            "source_page_start": "KR1a0001_tls_035-6a",
            "status": "MAPPED"
          },
          "line": 1
        },
        {
          "marker": "六二",
          "classical_text": "晉如，愁如，貞吉。受茲介福于其王母。",
          "source_page_start": "KR1a0001_tls_035-7a",
          "xiaoxiang": {
            "classical_text": "「受茲介福」、以中正也。",
            "source_page_start": "KR1a0001_tls_035-8a",
            "status": "MAPPED"
          },
          "line": 2
        },
        {
          "marker": "六三",
          "classical_text": "眾允，悔亡。",
          "source_page_start": "KR1a0001_tls_035-9a",
          "xiaoxiang": {
            "classical_text": "「眾允」之、志上行也。",
            "source_page_start": "KR1a0001_tls_035-10a",
            "status": "MAPPED"
          },
          "line": 3
        },
        {
          "marker": "九四",
          "classical_text": "晉如鼫鼠，貞厲。",
          "source_page_start": "KR1a0001_tls_035-11a",
          "xiaoxiang": {
            "classical_text": "「鼫鼠貞厲」、位不當也。",
            "source_page_start": "KR1a0001_tls_035-12a",
            "status": "MAPPED"
          },
          "line": 4
        },
        {
          "marker": "六五",
          "classical_text": "悔亡，失得勿恤。往吉，无不利。",
          "source_page_start": "KR1a0001_tls_035-13a",
          "xiaoxiang": {
            "classical_text": "「失得勿恤」、往有慶也。",
            "source_page_start": "KR1a0001_tls_035-14a",
            "status": "MAPPED"
          },
          "line": 5
        },
        {
          "marker": "上九",
          "classical_text": "晉其角，維用伐邑，厲吉，无咎，貞吝。",
          "source_page_start": "KR1a0001_tls_035-15a",
          "xiaoxiang": {
            "classical_text": "「維用伐邑」、道未光也。",
            "source_page_start": "KR1a0001_tls_035-16a",
            "status": "MAPPED"
          },
          "line": 6
        }
      ],
      "use_line": null,
      "raw_classical_transcription": "《晉》康侯用錫馬蕃庶，晝日三接。《彖》曰：《晉》、進也。明出地上。順而麗乎大明，柔進而上行，是以「康侯」用「錫馬蕃庶晝日三接」也。《象》曰：明出地上，《晉》。君子以自昭明德。初六：晉如摧如，貞吉。罔孚，裕无咎。《象》曰：「晉如摧如」、獨行正也，「裕无咎」、未受命也。六二：晉如，愁如，貞吉。受茲介福于其王母。《象》曰：「受茲介福」、以中正也。六三：眾允，悔亡。《象》曰：「眾允」之、志上行也。九四：晉如鼫鼠，貞厲。《象》曰：「鼫鼠貞厲」、位不當也。六五：悔亡，失得勿恤。往吉，无不利。《象》曰：「失得勿恤」、往有慶也。上九：晉其角，維用伐邑，厲吉，无咎，貞吝。《象》曰：「維用伐邑」、道未光也。",
