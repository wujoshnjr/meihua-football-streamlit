    {
      "number": 43,
      "name": "夬",
      "symbol": "䷪",
      "upper": "兌",
      "lower": "乾",
      "source_name": "夬",
      "guaci": {
        "classical_text": "揚于王庭，孚號有厲，告自邑。不利即戎，利有攸往。",
        "source_page_start": "KR1a0001_tls_043-2a"
      },
      "tuan": {
        "classical_text": "《夬》、決也，剛決柔也。健而說，決而和。「揚于王庭」、柔乘五剛也，「孚號有厲」、其危乃光也。「告自邑不利即戎」、所尚乃窮也，「利有攸往」、剛長乃終也。",
        "source_page_start": "KR1a0001_tls_043-3a"
      },
      "xiang": {
        "classical_text": "澤上於天，《夬》。君子以施祿及下，居德則忌。",
        "source_page_start": "KR1a0001_tls_043-4a",
        "note": null
      },
      "lines": [
        {
          "marker": "初九",
          "classical_text": "壯于前趾，往不勝，為咎。",
          "source_page_start": "KR1a0001_tls_043-5a",
          "xiaoxiang": {
            "classical_text": "「不勝」而「往」、「咎」也。",
            "source_page_start": "KR1a0001_tls_043-6a",
            "status": "MAPPED"
          },
          "line": 1
        },
        {
          "marker": "九二",
          "classical_text": "惕號，莫夜有戎，勿恤。",
          "source_page_start": "KR1a0001_tls_043-7a",
          "xiaoxiang": {
            "classical_text": "「有戎勿恤」、得中道也。",
            "source_page_start": "KR1a0001_tls_043-8a",
            "status": "MAPPED"
          },
          "line": 2
        },
        {
          "marker": "九三",
          "classical_text": "壯于頄，有凶。君子夬夬，獨行遇雨、若濡，有慍无咎。",
          "source_page_start": "KR1a0001_tls_043-9a",
          "xiaoxiang": {
            "classical_text": "「君子夬夬」、終「无咎」也。",
            "source_page_start": "KR1a0001_tls_043-10a",
            "status": "MAPPED"
          },
          "line": 3
        },
        {
          "marker": "九四",
          "classical_text": "臀无膚，其行次且。牽羊悔亡。聞言不信。",
          "source_page_start": "KR1a0001_tls_043-11a",
          "xiaoxiang": {
            "classical_text": "「其行次且」、位不當也，「聞言不信」、聰不明也。",
            "source_page_start": "KR1a0001_tls_043-12a",
            "status": "MAPPED"
          },
          "line": 4
        },
        {
          "marker": "九五",
          "classical_text": "莧陸夬夬，中行无咎。",
          "source_page_start": "KR1a0001_tls_043-13a",
          "xiaoxiang": {
            "classical_text": "「中行无咎」、中未光也。",
            "source_page_start": "KR1a0001_tls_043-14a",
            "status": "MAPPED"
          },
          "line": 5
        },
        {
          "marker": "上六",
          "classical_text": "无號，終有凶。",
          "source_page_start": "KR1a0001_tls_043-15a",
