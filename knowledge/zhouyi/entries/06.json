    {
      "number": 46,
      "name": "升",
      "symbol": "䷭",
      "upper": "坤",
      "lower": "巽",
      "source_name": "升",
      "guaci": {
        "classical_text": "元亨。用見大人，勿恤。南征吉。",
        "source_page_start": "KR1a0001_tls_046-2a"
      },
      "tuan": {
        "classical_text": "柔以時升，巽而順，剛中而應，是以大「亨」。「用見大人勿恤」、有慶也，「南征吉」、志行也。",
        "source_page_start": "KR1a0001_tls_046-3a"
      },
      "xiang": {
        "classical_text": "地中生木，升。君子以順德，積小以高大。",
        "source_page_start": "KR1a0001_tls_046-4a",
        "note": null
      },
      "lines": [
        {
          "marker": "初六",
          "classical_text": "允升，大吉。",
          "source_page_start": "KR1a0001_tls_046-5a",
          "xiaoxiang": {
            "classical_text": "「允升大吉」、上合志也。",
            "source_page_start": "KR1a0001_tls_046-6a",
            "status": "MAPPED"
          },
          "line": 1
        },
        {
          "marker": "九二",
          "classical_text": "孚乃利用禴，无咎。",
          "source_page_start": "KR1a0001_tls_046-7a",
          "xiaoxiang": {
            "classical_text": "「九二」之「孚」、有喜也。",
            "source_page_start": "KR1a0001_tls_046-8a",
            "status": "MAPPED"
          },
          "line": 2
        },
        {
          "marker": "九三",
          "classical_text": "升虛邑。",
          "source_page_start": "KR1a0001_tls_046-9a",
          "xiaoxiang": {
            "classical_text": "「升虛邑」、无所疑也。",
            "source_page_start": "KR1a0001_tls_046-10a",
            "status": "MAPPED"
          },
          "line": 3
        },
        {
          "marker": "六四",
          "classical_text": "王用亨于岐山，吉，无咎。",
          "source_page_start": "KR1a0001_tls_046-11a",
          "xiaoxiang": {
            "classical_text": "「王用亨于岐山」、順事也。",
            "source_page_start": "KR1a0001_tls_046-12a",
            "status": "MAPPED"
          },
          "line": 4
        },
        {
          "marker": "六五",
          "classical_text": "貞吉，升階。",
          "source_page_start": "KR1a0001_tls_046-13a",
          "xiaoxiang": {
            "classical_text": "「貞吉升階」、大得志也。",
            "source_page_start": "KR1a0001_tls_046-14a",
            "status": "MAPPED"
          },
          "line": 5
        },
        {
          "marker": "上六",
          "classical_text": "冥升，利于不息之貞。",
