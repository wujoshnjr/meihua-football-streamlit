          "xiaoxiang": {
            "classical_text": "「據于蒺蔾」、乘剛也，「入于其宮不見其妻」、不祥也。",
            "source_page_start": "KR1a0001_tls_047-10a",
            "status": "MAPPED"
          },
          "line": 3
        },
        {
          "marker": "九四",
          "classical_text": "來徐徐，困于金車，吝，有終。",
          "source_page_start": "KR1a0001_tls_047-11a",
          "xiaoxiang": {
            "classical_text": "「來徐徐」、志在下也。雖不當位，有與也。",
            "source_page_start": "KR1a0001_tls_047-12a",
            "status": "MAPPED"
          },
          "line": 4
        },
        {
          "marker": "九五",
          "classical_text": "劓刖，困于赤紱，乃徐有說，利用祭祀。",
          "source_page_start": "KR1a0001_tls_047-13a",
          "xiaoxiang": {
            "classical_text": "「劓刖」、志未得也，「乃徐有說」、以中直也，「利用祭祀」、受福也。",
            "source_page_start": "KR1a0001_tls_047-14a",
            "status": "MAPPED"
          },
          "line": 5
        },
        {
          "marker": "上六",
          "classical_text": "困于葛藟，于臲卼，曰動悔有悔，征吉。",
