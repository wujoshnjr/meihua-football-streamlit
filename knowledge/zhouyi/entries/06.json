      "name": "姤",
      "symbol": "䷫",
      "upper": "乾",
      "lower": "巽",
      "source_name": "姤",
      "guaci": {
        "classical_text": "女壯，勿用取女。",
        "source_page_start": "KR1a0001_tls_044-2a"
      },
      "tuan": {
        "classical_text": "《姤》、遇也，柔遇剛也。「勿用取女」、不可與長也。天地相遇，品物咸章也。剛遇中正，天下大行也。《姤》之時義大矣哉！",
        "source_page_start": "KR1a0001_tls_044-3a"
      },
      "xiang": {
        "classical_text": "天下有風，《姤》。后以施命誥四方。",
        "source_page_start": "KR1a0001_tls_044-4a",
        "note": null
      },
      "lines": [
        {
          "marker": "初六",
          "classical_text": "繫于金柅，貞吉。有攸往，見凶，羸豕孚蹢躅。",
          "source_page_start": "KR1a0001_tls_044-5a",
