      "source_name": "困",
      "guaci": {
        "classical_text": "亨。貞大人吉，无咎。有言不信。",
        "source_page_start": "KR1a0001_tls_047-2a"
      },
      "tuan": {
        "classical_text": "《困》、剛揜也。險以說，困而不失其所，「亨」，其唯君子乎。「貞大人吉」、以剛中也，「有言不信」、尚口乃窮也。",
        "source_page_start": "KR1a0001_tls_047-3a"
      },
      "xiang": {
        "classical_text": "澤无水，困。君子以致命遂志。",
        "source_page_start": "KR1a0001_tls_047-4a",
        "note": null
      },
      "lines": [
        {
          "marker": "初六",
          "classical_text": "臀困于株木，入于幽谷，三歲不覿。",
          "source_page_start": "KR1a0001_tls_047-5a",
          "xiaoxiang": {
            "classical_text": "「入于幽谷」，幽、不明也。",
            "source_page_start": "KR1a0001_tls_047-6a",
            "status": "MAPPED"
          },
          "line": 1
        },
        {
          "marker": "九二",
          "classical_text": "困于酒食，朱紱方來。利用享祀。征凶无咎。",
          "source_page_start": "KR1a0001_tls_047-7a",
          "xiaoxiang": {
            "classical_text": "「困于酒食」、中有慶也。",
            "source_page_start": "KR1a0001_tls_047-8a",
            "status": "MAPPED"
          },
          "line": 2
        },
        {
          "marker": "六三",
          "classical_text": "困于石，據于蒺蔾，入于其宮，不見其妻，凶。",
