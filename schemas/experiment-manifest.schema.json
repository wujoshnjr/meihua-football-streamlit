{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/schemas/experiment-manifest.schema.json",
  "title": "JARVIS chronological experiment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "git_commit",
    "train_end",
    "validation_end",
    "calibration_end",
    "assignments",
    "counts",
    "source_payload_sha256",
    "test_set_sha256",
    "fingerprint_sha256"
  ],
  "properties": {
    "schema_version": {"const": "jarvis-chronological-split-v1.0.0"},
    "experiment_id": {"type": "string", "minLength": 1},
    "git_commit": {"type": "string", "minLength": 7, "maxLength": 64},
    "train_end": {"type": "string", "format": "date-time"},
    "validation_end": {"type": "string", "format": "date-time"},
    "calibration_end": {"type": "string", "format": "date-time"},
    "assignments": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "match_id", "event_at", "competition", "evaluation_block",
          "payload_sha256", "dataset_role", "experiment_id"
        ],
        "properties": {
          "match_id": {"type": "string", "minLength": 1},
          "event_at": {"type": "string", "format": "date-time"},
          "competition": {"type": "string", "minLength": 1},
          "evaluation_block": {"type": "string", "minLength": 1},
          "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "dataset_role": {"enum": ["TRAIN", "VALIDATION", "CALIBRATION", "TEST_UNTOUCHED"]},
          "experiment_id": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "counts": {
      "type": "object",
      "required": ["TRAIN", "VALIDATION", "CALIBRATION", "TEST_UNTOUCHED"],
      "properties": {
        "TRAIN": {"type": "integer", "minimum": 1},
        "VALIDATION": {"type": "integer", "minimum": 1},
        "CALIBRATION": {"type": "integer", "minimum": 1},
        "TEST_UNTOUCHED": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "source_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "test_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
