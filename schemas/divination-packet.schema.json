{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wujoshnjr/meihua-football-streamlit/schemas/divination-packet.schema.json",
  "title": "LEGACY JARVIS DIVINATION_PACKET_V1",
  "type": "object",
  "required": [
    "schema_version",
    "packet_purpose",
    "system",
    "question",
    "event",
    "method",
    "knowledge_context",
    "ai_interpretation_contract",
    "packet_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "DIVINATION_PACKET_V1"
    },
    "packet_purpose": {
      "const": "JARVIS_CAST_AND_RETRIEVE__CHATGPT_INTERPRETS"
    },
    "system": {
      "enum": [
        "QIMEN_DUNJIA",
        "MEIHUA_YISHU"
      ]
    },
    "question": {
      "type": "object",
      "required": [
        "text",
        "category"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "general",
            "football_match"
          ]
        }
      }
    },
    "event": {
      "type": "object",
      "required": [
        "datetime",
        "timezone"
      ],
      "properties": {
        "datetime": {
          "type": "string",
          "minLength": 1
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "method": {
      "type": "object"
    },
    "host_guest": {
      "type": [
        "object",
        "null"
      ]
    },
    "football_fixture": {
      "type": [
        "object",
        "null"
      ]
    },
    "chart": {
      "type": "object"
    },
    "hexagram": {
      "type": "object"
    },
    "knowledge_context": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "ai_interpretation_contract": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "packet_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "system": {
            "const": "QIMEN_DUNJIA"
          }
        }
      },
      "then": {
        "required": [
          "chart",
          "host_guest"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "system": {
            "const": "MEIHUA_YISHU"
          }
        }
      },
      "then": {
        "required": [
          "hexagram",
          "football_fixture"
        ]
      }
    }
  ],
  "additionalProperties": true,
  "description": "Deprecated compatibility schema. New artifacts use schemas/divination_packet_v2.schema.json; do not use this V1 schema for event-identity or participant-layer validation.",
  "deprecated": true
}
