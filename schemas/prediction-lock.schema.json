{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/schemas/prediction-lock.schema.json",
  "title": "JARVIS pre-match prediction lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "match_id",
    "event_at",
    "locked_at",
    "data_as_of",
    "forecast_horizon",
    "lineup_status",
    "competition",
    "evaluation_block",
    "dataset_role",
    "experiment_id",
    "model_version",
    "score_model",
    "qimen_feature_version",
    "qimen_mode",
    "expected_home_goals",
    "expected_away_goals",
    "home_win_probability",
    "draw_probability",
    "away_win_probability",
    "predicted_result",
    "top_scorelines",
    "prediction_payload",
    "fingerprint_sha256"
  ],
  "properties": {
    "match_id": {"type": "string", "minLength": 1},
    "event_at": {"type": "string", "format": "date-time"},
    "locked_at": {"type": "string", "format": "date-time"},
    "data_as_of": {"type": "string", "format": "date-time"},
    "forecast_horizon": {"enum": ["EARLY", "LINEUP"]},
    "lineup_status": {"enum": ["UNAVAILABLE", "PARTIAL", "OFFICIAL_BOTH"]},
    "competition": {"type": "string"},
    "evaluation_block": {"type": "string"},
    "dataset_role": {"enum": ["PROSPECTIVE", "TRAIN", "VALIDATION", "CALIBRATION", "TEST_UNTOUCHED"]},
    "experiment_id": {"type": "string"},
    "model_version": {"type": "string", "minLength": 1},
    "score_model": {"enum": ["INDEPENDENT_POISSON", "DIXON_COLES"]},
    "qimen_feature_version": {"type": "string", "minLength": 1},
    "qimen_mode": {"enum": ["SHADOW_ONLY", "EXPERIMENTAL", "ENABLED"]},
    "expected_home_goals": {"type": "number", "minimum": 0},
    "expected_away_goals": {"type": "number", "minimum": 0},
    "home_win_probability": {"type": "number", "minimum": 0, "maximum": 1},
    "draw_probability": {"type": "number", "minimum": 0, "maximum": 1},
    "away_win_probability": {"type": "number", "minimum": 0, "maximum": 1},
    "predicted_result": {"enum": ["主勝", "和局", "客勝"]},
    "top_scorelines": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {"type": "integer", "minimum": 0},
          {"type": "integer", "minimum": 0},
          {"type": "number", "minimum": 0, "maximum": 1}
        ],
        "minItems": 3,
        "maxItems": 3
      }
    },
    "prediction_payload": {"type": "object"},
    "fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
